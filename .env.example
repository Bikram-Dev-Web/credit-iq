# CreditIQ v2 settings. Copy to .env and edit. Never commit .env.
# docker compose reads ANALYST_KEY / ADMIN_KEY / AUDIT_HASH_KEY / POSTGRES_PASSWORD from here (dev defaults otherwise).

# ---- API (services/api) ----
ENVIRONMENT=local                      # local | test | ci | docker | demo | production
DATABASE_URL=sqlite:///storage/creditiq.db   # Postgres: postgresql+psycopg://user:pass@host:5432/creditiq
REGISTRY_BACKEND=file                  # file (exported registry) | mlflow
FILE_REGISTRY_PATH=models/registry
# MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=creditiq-pd
MODEL_ALIAS=production
REGISTRY_POLL_SECONDS=30
POLICIES_DIR=policies
# ACTIVE_POLICY=2026.10.1
API_KEYS=analyst:dev-analyst-key-change-me,admin:dev-admin-key-change-me
AUDIT_HASH_KEY=dev-only-audit-key-change-me
AUDIT_HASH_KEY_ID=k1
ALLOW_ADMIN_ACTIONS=true
RATE_LIMIT_SCORE=600/minute
BATCH_MAX_ROWS=10000
BATCH_MAX_BYTES=5000000
CORS_ORIGINS=http://localhost:3000
# GRAFANA_URL=http://localhost:3001/d/creditiq-overview
# MLFLOW_UI_URL=http://localhost:5000

# ---- Monitor (services/monitor) ----
MONITOR_INBOX=storage/inbox
MONITOR_AUDIT_HOURS=24
DRIFT_PSI_MODERATE=0.10
DRIFT_PSI_SIGNIFICANT=0.25
DRIFT_SCORE_PSI=0.10
DRIFT_MISSING_CHANGE=0.10
# ALERT_WEBHOOK_URL=

# ---- Trainer ----
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db   (default when unset)

# ---- docker compose ----
ANALYST_KEY=dev-analyst-key-change-me
ADMIN_KEY=dev-admin-key-change-me
POSTGRES_PASSWORD=creditiq-dev
GRAFANA_ADMIN_PASSWORD=creditiq-dev
