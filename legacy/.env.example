# Optional settings. Copy to .env and edit; CreditIQ reads this file at start-up.
# No API keys are needed — the app never calls external services.

# Where runtime files are kept (defaults shown are relative to the project folder)
# CREDITIQ_DATA_DIR=./data
# CREDITIQ_MODELS_DIR=./models
# CREDITIQ_REPORTS_DIR=./reports
# CREDITIQ_STORAGE_DIR=./storage

# Largest CSV accepted by the in-app uploader (MB). Also raise server.maxUploadSize
# in .streamlit/config.toml if you go above 400.
# CREDITIQ_MAX_UPLOAD_MB=400
